         </BorderPane.margin>
      </ButtonBar>
   </bottom>
   <padding>
      <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
   </padding>
   <top>
      <Label text="Agendamaker" BorderPane.alignment="CENTER">
         <font>
            <Font name="Snell Roundhand Bold" size="36.0" />
         </font>
         <BorderPane.margin>
            <Insets bottom="8.0" left="8.0" right="8.0" />
         </BorderPane.margin>
      </Label>
   </top>
</BorderPane>
